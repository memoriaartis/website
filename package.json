    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "markdown-it": "^15.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.1"
}
