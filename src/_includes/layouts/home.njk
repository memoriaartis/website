---
layout: layouts/base.njk
---
<section class='hero {% if not (heroImage | hasPhoto) %}without-image{% endif %}'>
  <div class='hero-copy'>
    <p class='eyebrow'>{{ eyebrow }}</p>
    <h1>{{ heading }}</h1>
    <p class='intro'>{{ intro }}</p>
    <div class="actions">
      <a class='button primary' href='{{ primaryCta.href }}'>{{ primaryCta.label }}</a>
      <a class='text-link' href='{{ secondaryCta.href }}'>{{ secondaryCta.label }}</a>
    </div>
  </div>
  {{ heroImage | photo | safe }}
</section>

<section class='section statement'>
  <h2>{{ statementHeading }}</h2>
  <div class='statement-copy'>
    {{ statement | md | safe }}
    <a class='text-link' href='{{ statementLink.href }}'>{{ statementLink.label }}</a>
  </div>
</section>

<section class='section photo-story image-first {% if not (encounterImage | hasPhoto) %}without-image{% endif %}'>
  <div class='story-copy'>{{ encounter | md | safe }}</div>
  {{ encounterImage | photo | safe }}
</section>

<section class='section'>
  <h2>{{ activities.heading }}</h2>
  <div class='columns activities'>
    {% for item in activities.items %}
    <article><h3>{{ item.title }}</h3>{{ item.text | md | safe }}</article>
    {% endfor %}
  </div>
</section>

<section class='section'>
  <h2>{{ stages.heading }}</h2>
  <div class='columns two-columns development'>
    {% for item in stages.items %}
    <article><h3>{{ item.title }}</h3>{{ item.text | md | safe }}</article>
    {% endfor %}
  </div>
</section>

<section class='invitation '>
  <h2>{{ invitation.heading }}</h2>
  <div>
    {{ invitation.text | md | safe }}
    <a class='button primary' href='{{ invitation.cta.href }}'>{{ invitation.cta.label }}</a>
  </div>
</section>
