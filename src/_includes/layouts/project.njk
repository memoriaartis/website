---
layout: layouts/base.njk
---
<div class='page-intro'>
  <p class='eyebrow'>{{ eyebrow }}</p>
  <h1>{{ heading }}</h1>
  <p class='intro'>{{ intro }}</p>
</div>

<section class='section photo-story image-first {% if not (reasonImage | hasPhoto) %}without-image{% endif %}'>
  <div class='story-copy'>{{ reason | md | safe }}</div>
  {{ reasonImage | photo | safe }}
</section>

<section class='section editorial-copy origin'>{{ funding | md | safe }}</section>

<section id='base-patrimoniale' class='section editorial-copy origin'>{{ archive | md | safe }}</section>

<section class='section'>
  <h2>{{ beneficiaries.heading }}</h2>
  <div class='columns beneficiaries'>
    {% for item in beneficiaries.items %}
    <article><h3>{{ item.title }}</h3>{{ item.text | md | safe }}</article>
    {% endfor %}
  </div>
</section>

<section class='section photo-story  {% if not (contributionImage | hasPhoto) %}without-image{% endif %}'>
  <div class='story-copy'>
    {{ contribution | md | safe }}
    <a class='text-link' href='{{ contributionLink.href }}'>{{ contributionLink.label }}</a>
  </div>
  {{ contributionImage | photo | safe }}
</section>

<section class='invitation quiet'>
  <h2>{{ invitation.heading }}</h2>
  <div>
    {{ invitation.text | md | safe }}
    <a class='button primary' href='{{ invitation.cta.href }}'>{{ invitation.cta.label }}</a>
  </div>
</section>
