<!doctype html>
<html lang='{{ ui.lang }}'>
<head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><meta name='theme-color' content='#f5f2eb'><meta name='robots' content='{% if site.production %}index, follow{% else %}noindex, nofollow{% endif %}'><title>{{ title }}</title><meta name='description' content='{{ description }}'>{% if site.config.origin %}<link rel='canonical' href='{{ site.config.origin }}{{ page.url }}'>{% endif %}<link rel='stylesheet' href='/assets/site.css'><script defer src='/assets/site.js'></script></head>
<body><a class='skip' href='#contenu'>{{ ui.skip }}</a>
<header class='site-header{% if nav == "home" %} header-overlay{% endif %}'><div class='wrap header-inner'><a class='wordmark' href='{{ routes.home }}'>{{ ui.name }}</a><button class='menu-button' type='button' aria-controls='navigation' aria-expanded='false' data-menu-toggle data-open='{{ ui.menu }}' data-close='{{ ui.closeMenu }}'>{{ ui.menu }}</button><nav class='navigation' id='navigation' aria-label='{{ ui.navigationLabel }}' data-menu>{% for key in ['home', 'project', 'approach', 'contact'] %}<a class='{% if key == "home" %}mobile-home{% elif key == "contact" %}contact-link{% endif %}' href='{{ routes[key] }}'{% if nav == key %} aria-current='page'{% endif %}>{{ ui.nav[key] }}</a>{% endfor %}</nav></div></header>
<main class='{% if nav == "home" %}home-main{% else %}wrap{% endif %}' id='contenu' tabindex='-1'>{{ content | safe }}</main>
<footer class='site-footer'><div class='wrap'><div class='footer-top'><div class='footer-brand'><a class='wordmark' href='{{ routes.home }}'>{{ ui.name }}</a><p>{{ ui.footerDescription }}</p></div><nav class='footer-links' aria-label='{{ ui.footerNavigationLabel }}'>{% for key in ['project', 'approach', 'contact', 'legal', 'privacy'] %}<a href='{{ routes[key] }}'>{{ ui.nav[key] }}</a>{% endfor %}</nav></div><div class='copyright'>&copy; {{ site.year }} {{ ui.name }}</div></div></footer></body></html>
